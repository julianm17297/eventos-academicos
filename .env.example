# Copie este archivo como "backend/.env" y ajuste los valores si lo necesita.
# No incluya contraseñas ni datos reales en el repositorio.

# Base de datos (SQLite local por defecto)
DATABASE_URL=sqlite:///./eventos.db

# Solo se aceptan cuentas con este dominio de correo (personas de la institución)
DOMINIO_INSTITUCIONAL=institucion.edu.co

# Horas que dura una sesión iniciada
HORAS_SESION=8
